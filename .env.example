# Server
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://your-domain.example
TRUST_PROXY=true

# Shared administrator login
# Generate a bcrypt hash; never put the plaintext password in this file.
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_DAYS=7

# Storage
# Recommended for production. If unset, the app uses DATA_DIR/store.json.
# Set STORAGE_MODE=json only for local fallback testing.
# STORAGE_MODE=json
MONGODB_URI=
MONGODB_DB=omsons_qr
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10
MONGODB_FAMILY=4
STORAGE_RETRY_DELAY_MS=5000
DATA_DIR=./data

# Cloudinary QR storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=omsons-qr-labels

# Certificate PDF rendering
PYTHON=python3
CERTIFICATE_TEMPLATE_FILE=./data/templates/syringe-filter-certificate.pdf
