{
  "name": "omsons-qr-labels",
  "version": "0.1.0",
  "private": true,
  "description": "Omsons QR label and COA certificate generator",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
